{
  "name": "plane-shooter-game",
  "version": "1.0.0",
  "description": "全民飞机大战 - 街机风格垂直卷轴射击游戏",
  "main": "index.html",
  "scripts": {
    "test": "node test_headless.js",
    "test:watch": "nodemon test_headless.js",
    "serve": "node dev-server.js",
    "install-test": "npm install --save-dev jsdom",
    "dev": "node dev-server.js",
    "test:phase3": "node test_phase3.js",
    "test:p0": "node test_p0.js",
    "test:all": "npm test && npm run test:phase3 && npm run test:p0 && npm run test:aircraft && npm run test:equipment && npm run test:pets && npm run test:gear-fx",
    "test:aircraft": "node test_aircraft.js",
    "test:equipment": "node test_equipment.js",
    "test:pets": "node test_pets.js",
    "test:gear-fx": "node test_gear_effects.js"
  },
  "keywords": [
    "game",
    "arcade",
    "shooter",
    "canvas",
    "javascript"
  ],
  "author": "Game Development Team",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^22.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
